        <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Prevent space in username
        const username = document.getElementById('username');
        if (username) {
            username.addEventListener('keypress', function(e) {
                return e.which !== 32;
            });
        }

        const countrySelect = document.getElementById('country');
        const countryHint = document.getElementById('countryHint');
        const oldCountry = countrySelect ? countrySelect.dataset.oldCountry : '';

        function setCountryOption(countryName) {
            if (!countrySelect || !countryName) {
                return false;
            }

            const normalize = (value) => (value || '').trim().toLowerCase();
            const target = normalize(countryName);
            const options = Array.from(countrySelect.options);
            const matched = options.find((option) =>
                normalize(option.value) === target || normalize(option.textContent) === target
            );

            if (matched) {
                countrySelect.value = matched.value;
                return true;
            }

            return false;
        }

        // Only auto-detect when country wasn't already chosen by user/old input.
        if (countrySelect && !oldCountry && !countrySelect.value) {
            fetch('https://ipapi.co/json/')
                .then((response) => response.ok ? response.json() : Promise.reject())
                .then((data) => {
                    const selected = setCountryOption(data.country_name);
                    if (countryHint) {
                        countryHint.textContent = selected
                            ? 'Country auto-detected. You can still change it.'
                            : 'Could not auto-match your country. Please select manually.';
                    }
                })
                .catch(() => {
                    if (countryHint) {
                        countryHint.textContent = 'Could not auto-detect country. Please select manually.';
                    }
                });
        } else if (countryHint) {
            countryHint.textContent = 'You can change your country at any time before submitting.';
        }
    });
</script>

