<script>
(function () {
    var url = "https:\/\/swantradecapital.com\/dashboard\/api\/stock-ticker";
    var loadingEl = document.getElementById('stock-ticker-loading');
    var viewportEl = document.getElementById('stock-ticker-viewport');
    var trackEl = document.getElementById('stock-ticker-track');
    if (!trackEl || !viewportEl) return;

    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
    }

    function stockLogoUrl(symbol) {
        var raw = String(symbol || '').replace(/[^A-Za-z0-9.\-]/g, '').toUpperCase();
        if (!raw) return '';
        return 'https://financialmodelingprep.com/image-stock/' + encodeURIComponent(raw) + '.png';
    }

    function buildItem(q) {
        var sym = esc(q.symbol);
        var price = typeof q.price === 'number' ? q.price.toFixed(2) : esc(q.price);
        var ch = Number(q.change);
        var chp = Number(q.changePercent);
        var up = ch >= 0;
        var color = up ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400';
        var sign = ch > 0 ? '+' : '';
        var stockUrl = "https:\/\/swantradecapital.com\/dashboard\/trading\/stocks" + '/' + encodeURIComponent(q.symbol);
        var logoSrc = stockLogoUrl(q.symbol);
        var logoHtml = logoSrc
            ? '<img src="' + logoSrc + '" alt="" width="16" height="16" class="h-4 w-4 rounded-full object-cover shrink-0 ring-1 ring-black/5 dark:ring-white/10" loading="lazy" onerror="this.style.visibility=\'hidden\'">'
            : '';
        return (
            '<a href="' + esc(stockUrl) + '" class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-medium dark:text-gray-200 text-gray-800 hover:text-primary transition-colors">' +
                logoHtml +
                '<span class="font-semibold tracking-tight">' + sym + '</span>' +
                '<span class="tabular-nums">$' + price + '</span>' +
                '<span class="tabular-nums ' + color + '">' + sign + ch.toFixed(2) + ' (' + sign + chp.toFixed(2) + '%)</span>' +
            '</a>'
        );
    }

    function render(quotes) {
        if (!quotes || !quotes.length) {
            if (loadingEl) {
                loadingEl.textContent = 'Market data unavailable';
                loadingEl.classList.remove('hidden');
            }
            viewportEl.classList.add('hidden');
            return;
        }
        var html = quotes.map(buildItem).join('<span class="dark:text-gray-600 text-gray-300 select-none" aria-hidden="true">·</span>');
        trackEl.innerHTML = html + html;
        if (loadingEl) loadingEl.classList.add('hidden');
        viewportEl.classList.remove('hidden');
    }

    function load() {
        fetch(url, {
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.success && data.quotes) {
                    render(data.quotes);
                } else {
                    render([]);
                }
            })
            .catch(function () {
                render([]);
            });
    }

    load();
    setInterval(load, 120000);
})();
