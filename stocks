<script>
    // Global toast container
    if (!document.getElementById('toast-container')) {
        const toastContainer = document.createElement('div');
        toastContainer.id = 'toast-container';
        toastContainer.className = 'fixed bottom-4 right-4 z-50 flex flex-col gap-2';
        document.body.appendChild(toastContainer);
    }

    /**
     * Show a toast notification
     * @param  {string} type - 'success', 'error', 'warning', 'info'
     * @param  {string} message - The notification message
     * @param  {number} duration - How long to show the toast (in ms)
     * @param  {object} options - Additional options (icon, showProgress, etc)
     */
    function showToast(type = 'info', message = '', duration = 3000, options = {}) {
        const container = document.getElementById('toast-container');
        
        // Create toast element
        const toast = document.createElement('div');
        toast.className = 'toast rounded-lg shadow-lg p-4 max-w-md transform transition-all duration-300 ease-in-out translate-x-full';
        toast.style.minWidth = '300px';
        
        // Add type-specific classes
        switch (type) {
            case 'success':
                toast.classList.add('dark:bg-green-800', 'bg-green-100', 'dark:text-green-100', 'text-green-800', 'border-l-4', 'border-green-500');
                break;
            case 'error':
                toast.classList.add('dark:bg-red-800', 'bg-red-100', 'dark:text-red-100', 'text-red-800', 'border-l-4', 'border-red-500');
                break;
            case 'warning':
                toast.classList.add('dark:bg-amber-800', 'bg-amber-100', 'dark:text-amber-100', 'text-amber-800', 'border-l-4', 'border-amber-500');
                break;
            case 'info':
                toast.classList.add('dark:bg-blue-800', 'bg-blue-100', 'dark:text-blue-100', 'text-blue-800', 'border-l-4', 'border-blue-500');
                break;
        }
        
        // Set up icon based on type
        let icon = options.icon || '';
        if (!icon) {
            switch (type) {
                case 'success':
                    icon = '<i class="fas fa-check-circle text-xl mr-3 dark:text-green-200 text-green-600"></i>';
                    break;
                case 'error':
                    icon = '<i class="fas fa-exclamation-circle text-xl mr-3 dark:text-red-200 text-red-600"></i>';
                    break;
                case 'warning':
                    icon = '<i class="fas fa-exclamation-triangle text-xl mr-3 dark:text-amber-200 text-amber-600"></i>';
                    break;
                case 'info':
                    icon = '<i class="fas fa-info-circle text-xl mr-3 dark:text-blue-200 text-blue-600"></i>';
                    break;
            }
        }
        
        // Set up content
        toast.innerHTML = `
            <div class="flex items-center">
                ${icon}
                <div class="flex-1">
                    <div class="font-medium">${message}</div>
                </div>
                <button type="button" class="ml-3 dark:text-gray-300 text-gray-600 hover:text-gray-900 dark:hover:text-white">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            ${options.showProgress ? '<div class="progress-bar h-1 bg-white/20 mt-2 overflow-hidden"><div class="h-full progress-inner bg-white/50"></div></div>' : ''}
        `;
        
        // Add to container and animate in
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-x-full'), 10);
        
        // Set up close button
        const closeBtn = toast.querySelector('button');
        closeBtn.addEventListener('click', () => {
            removeToast(toast);
        });
        
        // Auto-remove after duration
        if (duration > 0) {
            if (options.showProgress) {
                const progressBar = toast.querySelector('.progress-inner');
                if (progressBar) {
                    progressBar.style.transition = `width ${duration}ms linear`;
                    setTimeout(() => {
                        progressBar.style.width = '100%';
                    }, 10);
                }
            }
            
            setTimeout(() => {
                removeToast(toast);
            }, duration);
        }
        
        return toast;
    }
    
    /**
     * Remove a toast from the container with animation
     */
    function removeToast(toast) {
        toast.classList.add('translate-x-full', 'opacity-0');
        
        // Remove from DOM after animation completes
        setTimeout(() => {
            if (toast.parentNode) {
                toast.parentNode.removeChild(toast);
            }
        }, 300);
    }
    
    // Success order notification with order details
    function showOrderSuccessToast(message, orderDetails = {}, duration = 3000) {
        const options = {
            showProgress: true,
            details: orderDetails
        };
        
        // Create enhanced message with order details
        let enhancedMessage = message;
        
        // Add order details if available
        if (orderDetails.symbol) {
            enhancedMessage += `<div class="text-sm mt-1 opacity-90">
                ${orderDetails.side === 'buy' ? 'Bought' : 'Sold'} 
                ${orderDetails.quantity} ${orderDetails.symbol} 
                ${orderDetails.order_type === 'market' ? 'at market price' : `at ${orderDetails.price}`}
            </div>`;
        }
        
        return showToast('success', enhancedMessage, duration, options);
    }
    
    // Error order notification
    function showOrderErrorToast(message, duration = 5000) {
        return showToast('error', message, duration, { showProgress: true });
    }
</script>

