                    .then(function (r) { return r.json(); })
                    .then(function (json) {
                        const rows = (json && json.success && Array.isArray(json.data)) ? json.data : [];
                        const mapped = mapCandleRows(rows);
                        if (mapped.length) {
                            candlestickSeries.setData(mapped);
                        } else {
                            candlestickSeries.setData(generateSampleData());
                        }
                        chart.timeScale().fitContent();
